# ===== PostgreSQL =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=lostfound
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this

# ===== Cloudinary =====
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ===== CLIP Service =====
CLIP_SERVICE_URL=http://localhost:8000
CLIP_MODEL_DIR=.local/models/clip_onnx_large_model
YOLO_MODEL_PATH=.local/models/yolov8n.pt
CLIP_SCORE_MIN=21.0
CLIP_SCORE_MAX=29.0
CLIP_MATCH_THRESHOLD=0.5

# ===== Ollama (AI vision-language enrichment) =====
# Tắt = false. Khi false, hệ thống bỏ qua hoàn toàn flow AI và vẫn chạy bình thường.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
# Tên model đã pull sẵn bằng: ollama pull <model>
# Gợi ý: qwen2.5vl, llama3.2-vision, llava, moondream
OLLAMA_VISION_MODEL=qwen2.5vl
# Timeout (giây) cho 1 request. Qwen-VL thường 5-30s/ảnh.
OLLAMA_TIMEOUT_SECONDS=60

# ===== Spring Boot =====
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/lostfound
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change_this
SERVER_PORT=8080

# ===== JWT =====
JWT_SECRET=dGhpc0lzQVZlcnlMb25nU2VjcmV0S2V5Rm9yRGV2ZWxvcG1lbnRPbmx5UGxlYXNlQ2hhbmdlSW5Qcm9kdWN0aW9u
JWT_ACCESS_EXPIRATION=1800000
JWT_REFRESH_EXPIRATION=604800000

# ===== Google OAuth2 =====
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ===== Mail (Gmail SMTP) =====
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# ===== CORS =====
CORS_ORIGINS=*
