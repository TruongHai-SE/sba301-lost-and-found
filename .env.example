# ===== PostgreSQL =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=lostfound
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this

# ===== Cloudinary =====
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ===== CLIP Service =====
CLIP_SERVICE_URL=http://localhost:8000
CLIP_MODEL_DIR=.local/models/clip_onnx_large_model
YOLO_MODEL_PATH=.local/models/yolov8n.pt
CLIP_SCORE_MIN=21.0
CLIP_SCORE_MAX=29.0
CLIP_MATCH_THRESHOLD=0.5

# ===== Spring Boot =====
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/lostfound
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change_this
SERVER_PORT=8080
