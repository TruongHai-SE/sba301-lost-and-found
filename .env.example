# ===== PostgreSQL =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=lostfound
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this

# ===== Cloudinary =====
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ===== CLIP Service =====
CLIP_SERVICE_URL=http://localhost:8000
CLIP_MODEL_DIR=clip-service/.local/models/clip_onnx_large_model
YOLO_MODEL_PATH=clip-service/.local/models/yolov8n.pt
TRANSLATION_MODEL_DIR=clip-service/.local/models/opus_mt_vi_en_onnx
CLIP_API_TOKEN=your-secure-api-token-here
CLIP_SCORE_MIN=21.0
CLIP_SCORE_MAX=29.0
CLIP_MATCH_THRESHOLD=0.5

# ===== Ollama (AI vision-language enrichment) =====
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=qwen2.5vl
OLLAMA_TIMEOUT_SECONDS=60

# ===== Spring Boot =====
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/lostfound
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change_this
SERVER_PORT=8080

# ===== JWT =====
JWT_SECRET=your_secure_jwt_secret_key_here_minimum_512_bits_base64_encoded
JWT_ACCESS_EXPIRATION=1800000
JWT_REFRESH_EXPIRATION=604800000

# ===== Google OAuth2 =====
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ===== Mail (Gmail SMTP) =====
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# ===== CORS =====
CORS_ORIGINS=*
